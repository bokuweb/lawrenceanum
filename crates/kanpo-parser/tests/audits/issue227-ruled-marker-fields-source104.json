  "change": {
    "rule": "Complete publication omission/addition/deletion markers, three collinear symmetric horizontal source rulings, unambiguous counterpart axes and complete native source occurrences prove local After/Before fields. Accept only complete contiguous Plain blocks after existing semantic restoration.",
    "marker_grammar": "Matching paired brackets around 新設/削る/略/同上/同左, optional arbitrary-length numeric/range prefix; entire marker band, at least one addition/deletion marker, unique body-axis counterparts. Not substring matching or expected-output reconstruction.",
    "geometry": "Original NativeBounds::Glyphs advance boxes and recorded Down axes of every transitive inline/legacy source member. Unknown/missing/shared/cyclic geometry and crossing source members are held. These are source advance boxes, not certified pixel ink.",
    "endpoint_policy": "A horizontal-rule endpoint is not a vertical wall. Known Down source occurrences may overhang an endpoint only with every source centerline inside and no recorded vertical rule crossed. Other/unknown axes need full containment.",
    "numeric_tolerance": "Source-rule collinearity/symmetry and inclusion use0.01times minimum original source-column width; no page-specific fixed-pt expansion, character-count/line-count/column-count cap.",
    "preservation": "Late overlay keeps existing classified comparison units, all complete Table lines and corrected unrelated Lines; requires exact nonwhitespace character conservation before computed renderer labels. Deterministic source membership expansion only for accepted roots.",
    "cross_page_priority": "A complete local role proof can reject a contradictory inferred whole-page divider. The old tier pipeline then runs before the local overlay. Certifying a local field does not newly enable legacy continuation guesses on the next page.",
    "not_added": [
      "page/company/expected-output branches",
      "new character/line/column-count limits",
      "character filling or dictionary correction",
      "OCR/model inference or automatic native/OCR append"
    ]
  },
